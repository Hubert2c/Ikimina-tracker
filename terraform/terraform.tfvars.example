# Copy to terraform.tfvars (ignored by Git) and fill in your own values.
location       = "southafricanorth" # must be a region your subscription allows
admin_cidr     = "198.51.100.10/32" # your public IP: curl ifconfig.me, then add /32
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

