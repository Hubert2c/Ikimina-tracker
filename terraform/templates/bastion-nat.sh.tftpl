#!/bin/bash
# Runs once at first boot (cloud-init user data). Turns the bastion into a
# small NAT instance so the private app VM can reach the internet (apt,
# Docker images, ECR) without a public IP. Ansible later adds a UFW "route"
# rule that lets this forwarded traffic through the host firewall.
set -euo pipefail

# 1. Let the kernel forward packets between hosts.
cat > /etc/sysctl.d/90-ikimina-nat.conf <<'EOF'
net.ipv4.ip_forward = 1
EOF
sysctl --system

# 2. Masquerade traffic from the private subnet behind the bastion's address.
cat > /usr/local/sbin/ikimina-nat.sh <<'EOF'
#!/bin/sh
set -eu
IFACE=$(ip -o -4 route show to default | awk '{print $5}' | head -n 1)
iptables -t nat -C POSTROUTING -s ${private_subnet_cidr} -o "$IFACE" -j MASQUERADE 2>/dev/null \
  || iptables -t nat -A POSTROUTING -s ${private_subnet_cidr} -o "$IFACE" -j MASQUERADE
EOF
chmod 0755 /usr/local/sbin/ikimina-nat.sh

# 3. Re-apply the rule on every boot.
cat > /etc/systemd/system/ikimina-nat.service <<'EOF'
[Unit]
Description=NAT for the Ikimina private subnet
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ikimina-nat.sh

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now ikimina-nat.service
