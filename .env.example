# Copy to .env and change the values:   cp .env.example .env
# Docker Compose reads .env automatically. Never commit the real .env file.

# Port on YOUR machine where the API will be available (http://localhost:5000)
APP_PORT=5000

# PostgreSQL credentials (used by both the db and app services)
POSTGRES_USER=ikimina
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ikimina

# Only for running WITHOUT Docker against your own Postgres. Leave unset to
# use in-memory storage.
# DATABASE_URL=postgresql://ikimina:password@localhost:5432/ikimina
