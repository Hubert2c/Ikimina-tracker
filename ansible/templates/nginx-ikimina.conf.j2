# Managed by Ansible (ikimina-tracker). Do not edit by hand.
# Public entry point: forwards port 80 on the bastion to the API container on
# the private app VM. The app VM itself has no public IP.

upstream ikimina_app {
    server {{ app_private_ip }}:{{ app_port }};
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    server_tokens off;            # don't advertise the nginx version
    client_max_body_size 16k;     # same 16 KB limit the app enforces

    # Liveness of the proxy itself (doesn't touch the app VM).
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://ikimina_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
