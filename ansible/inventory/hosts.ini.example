# Static inventory. Copy to hosts.ini (git-ignored) and replace the IP with
# the `public_ip` output of Terraform, or paste `terraform output -raw ansible_inventory`.
# For a dynamic inventory that needs no editing, use azure_rm.yml instead.
[app_servers]
ikimina-dev-vm ansible_host=203.0.113.10 ansible_user=ikiminaadmin ansible_ssh_private_key_file=~/.ssh/id_ed25519
